# =============================================================================
# .env.example — Template for environment variables
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Never commit `.env` itself — only this `.env.example` template.
# =============================================================================

# ----- App -----
APP_ENV=development                       # development | staging | production
APP_PORT=5080
APP_LOG_LEVEL=Information                 # Trace | Debug | Information | Warning | Error

# ----- Database (SQL Server) -----
DB_HOST=localhost
DB_PORT=1433
DB_NAME=eduportal_demo
DB_USER=sa
DB_PASSWORD=__CHANGE_ME__
DB_CONNECTION_STRING="Server=${DB_HOST},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=true"

# ----- Auth -----
JWT_SECRET=__GENERATE_64_CHAR_RANDOM__    # openssl rand -hex 32
JWT_ISSUER=eduportal-demo
JWT_AUDIENCE=eduportal-demo-client
JWT_EXPIRY_MINUTES=60

# ----- Optional services -----
REDIS_URL=redis://localhost:6379
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ----- Feature flags -----
FEATURE_BIOMETRIC_INGEST=true
FEATURE_DEBUG_ENDPOINTS=false

# ----- External (only if your demo needs them) -----
AZURE_STORAGE_CONNECTION=
POWERBI_WORKSPACE_ID=
