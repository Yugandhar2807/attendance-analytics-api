# ===========================================================================
# .env.example — copy to .env (gitignored) and fill in real values
# ===========================================================================

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5080

# --- AI assist (optional — leave blank to disable the /api/v1/ai endpoint) ---
ANTHROPIC_API_KEY=

# --- Tenants ---
# In docker-compose mode the tenant DB connection strings are read from
# appsettings.json. Override per-environment via env vars if needed:
#   TenantCatalog__Tenants__0__ConnectionString=Server=...
